# Existing Vercel services only. Never use a VITE_ prefix for server variables.
# Cloudflare password/session settings belong in ignored .dev.vars, not this file.
# See .dev.vars.example; never expose COTIZADOR_PIN_AUTH_SECRET through VITE_.
# Chosen-password derivation and secret schema version 3 are documented in docs/CLOUDFLARE.md.
# Private common catalogue; leave unconfigured until protected access is reviewed.
CATALOG_BLOB_URL=
BLOB_READ_WRITE_TOKEN=
# Disabled until the reviewed production deployment is explicitly activated.
INSTALER_OBSERVATION_MODE=disabled
INSTALER_OBSERVATION_INGEST_SECRET=
INSTALER_GOOGLE_EXPECTED_EMAIL=
INSTALER_DRIVE_FILE_ID=
INSTALER_OBSERVATION_BLOB_READ_WRITE_TOKEN=
# Separate from observation; enable only with a reviewed private policy and valid catalogue.
INSTALER_CATALOG_MODE=disabled
