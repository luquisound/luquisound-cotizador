{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luquisound-cotizador",
  "account_id": "b47cbdc6d9efa7d71fd1dd2ef8e5aa37",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "cotizador.luquisound.com", "custom_domain": true }
  ],
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "QUOTATION_BOARD_MODE": "shared",
    "QUOTATION_BOARD_ACCESS_REVIEWED": "true"
  },
  "d1_databases": [
    {
      "binding": "QUOTATION_BOARD_DB",
      "database_name": "luquisound-quotation-board",
      "database_id": "4ebaeb4d-abb7-416d-a576-efa95d903c63",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}
