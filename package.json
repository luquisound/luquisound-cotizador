{
  "name": "luquisound-cotizador",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview",
    "prepare:instaler": "node --experimental-strip-types scripts/prepare-instaler-snapshot.ts",
    "dev:cloudflare": "npm run build && wrangler dev --local --persist-to .agent-tmp/cloudflare",
    "db:cloudflare:local": "wrangler d1 migrations apply QUOTATION_BOARD_DB --local --persist-to .agent-tmp/cloudflare",
    "check:cloudflare": "node --experimental-strip-types scripts/check-cloudflare.ts"
  },
  "engines": {
    "node": "^22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/react": "0.5.1",
    "@vercel/blob": "2.8.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sax": "1.6.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sax": "1.2.7",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "4.157.0"
  }
}
